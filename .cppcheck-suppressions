# cppcheck suppressions for scripts/dev/run-static.sh: one <id>:<file> entry
# each, under a line that gives its reason. Each is a structural false
# positive in that file, so the entry carries no line number and survives
# edits elsewhere in the file.

# False positive: st is assigned (truncated) before anything reads it; binding
# the reference to the uninitialised dummy reads nothing.
legacyUninitvar:*/skycued/src/fisb/apdu.cpp

# False positive: Set::filled has a default member initializer (= 0), which
# cppcheck 2.9 does not see through the std::move into emplace().
uninitvar:*/skycued/src/fisb/segment_assembler.cpp

# False positive: cppcheck takes sac and sic at their initial 0, not seeing
# that program_options writes them through po::value(&sac) and po::value(&sic).
knownConditionTrueFalse:*/tools/skycue-pingsim.cpp

# False positive: the loop runs only while done < n, so count >= 1 and
# bytes_ holds at least two bytes when write() is called.
invalidFunctionArg:*/tools/iqgen/iq_writer.cpp

# False positive: Destination::id is a std::string; cppcheck reads the cue library's
# destination type as a pointer and the OutputDef id as an integer.
AssignmentAddressToInteger:*/skycued/src/hub/hub.cpp
