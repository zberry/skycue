root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
trim_trailing_whitespace = false

[*.{cpp,hpp,h,inc,in}]
indent_size = 4

[*.{js,json,cmake,sh,yml,yaml}]
indent_size = 2

[{CMakeLists.txt,*.txt}]
indent_size = 2
