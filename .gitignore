/build*/
/.superpowers/
/sources/
/dist/
*.tar.gz
/www/tiles/
/www/overlays/
/www/vendor/
/tests/ui/node_modules/
/tests/ui/test-results/
/docs/vendor/
*.cu8
__pycache__/
# State skycued writes next to a skycue.conf (e.g. etc/ when run from the
# repo): learned locations, the runtime overlay, and their set-aside copies.
fisb-locations.json
fisb-locations.json.rejected
fisb-locations.json.unreadable-*
skycue.runtime.json
skycue.runtime.json.rejected
*.unreadable-*
# Fuzz findings are copied here by scripts/dev/run-fuzz.sh; only the placeholder
# and the README are tracked.
/tests/fuzz/findings/*
!/tests/fuzz/findings/.gitkeep
!/tests/fuzz/findings/README.md
# Third-party test captures: fetched by scripts/test-data/fetch-test-captures.sh (pinned
# upstream commits and SHA-256 values), never committed once removed.
/tests/data/raw/*
!/tests/data/raw/modes-120s.golden.jsonl.gz
!/tests/data/raw/uat-sample.golden.jsonl.gz
!/tests/data/raw/uat-stratux.golden.jsonl.gz
!/tests/data/raw/uat-stratux-b.golden.jsonl.gz
!/tests/data/raw/uat-synthetic.golden.jsonl.gz
!/tests/data/raw/uat-synthetic.expect.jsonl.gz
/tests/data/fisb/tg30.978
/tests/data/fisb/received-with-uplinks.jsonl
/tests/data/fisb/received-tg30.jsonl
/tests/data/opensky/
/tests/data/iq/
# the test data's former location; old checkouts may still hold fetched files there
/tests/fixtures/

tests/ui/build/
