# Boost.System is header-only since Boost 1.69 and some distributions (Ubuntu 26.04, Boost 1.90)
# ship no boost_system CMake package. Provide Boost::system either way.
function(skycue_require_boost_system MIN_VERSION)
  if(TARGET Boost::system)
    return()
  endif()
  # BoostConfig first: CMake 3.30 warns (CMP0167) when the FindBoost module is used, and Boost
  # 1.70 and newer ship a config. Older Boost has none, so fall back to the module.
  find_package(Boost ${MIN_VERSION} CONFIG QUIET)
  if(NOT Boost_FOUND)
    find_package(Boost ${MIN_VERSION} REQUIRED)
  endif()
  find_package(Boost ${MIN_VERSION} CONFIG QUIET COMPONENTS system)
  if(NOT TARGET Boost::system)
    find_package(Boost ${MIN_VERSION} QUIET COMPONENTS system)
  endif()
  if(TARGET Boost::system)
    return()
  endif()
  if(DEFINED Boost_VERSION_STRING)
    set(_ver "${Boost_VERSION_STRING}")
  elseif(DEFINED Boost_VERSION AND Boost_VERSION MATCHES "^[0-9]+\\.")
    set(_ver "${Boost_VERSION}")
  elseif(DEFINED Boost_VERSION AND Boost_VERSION MATCHES "^[0-9]+$")
    # Boost_VERSION is the numeric form (MMmmpp, e.g. 107500) in module mode.
    math(EXPR _major "${Boost_VERSION} / 100000")
    math(EXPR _minor "${Boost_VERSION} / 100 % 1000")
    set(_ver "${_major}.${_minor}.0")
  else()
    message(FATAL_ERROR "skycue: cannot determine the Boost version")
  endif()
  if(_ver VERSION_LESS 1.69)
    message(FATAL_ERROR "skycue: Boost ${_ver} needs the compiled Boost.System library "
      "(install the boost system development package)")
  endif()
  if(TARGET Boost::headers)
    set(_headers Boost::headers)
  elseif(TARGET Boost::boost)
    set(_headers Boost::boost)
  else()
    message(FATAL_ERROR "skycue: no Boost header target found")
  endif()
  add_library(Boost::system INTERFACE IMPORTED GLOBAL)
  target_link_libraries(Boost::system INTERFACE ${_headers})
endfunction()
