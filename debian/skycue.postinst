#!/bin/sh
set -e

case "$1" in
    configure)
        adduser --system --group --home /var/lib/skycue --no-create-home --quiet skycue
        for d in /var/lib/skycue /var/lib/skycue/maps /var/lib/skycue/recordings; do
            install -d -o skycue -g skycue -m 0755 "$d"
        done
        # skycued stops on a missing list file; an empty list means no entries.
        for f in allow.list block.list; do
            if [ ! -e "/var/lib/skycue/$f" ]; then
                install -o skycue -g skycue -m 0644 /dev/null "/var/lib/skycue/$f"
            fi
        done
        # The daemon is unpacked by now: create /etc/skycue/skycue.toml.
        # BEGIN convert-conf-shared (identical in debian/skycue.postinst and the spec's post-install script; tests/scripts/test_package_postinst.sh runs both)
        # skycue_convert_one OLD NEW: write NEW from the old-style file OLD with
        # skycued --convert-conf (NEW takes OLD's owner and mode), then keep OLD as
        # OLD.converted. Returns 1, with OLD and NEW untouched and the reason printed,
        # when the conversion fails. SKYCUE_ROOT and SKYCUED are for the tests.
        skycue_convert_one() {
            old=$1 new=$2
            tmp=$new.tmp.$$
            if "${SKYCUED:-/usr/bin/skycued}" --convert-conf "$old" > "$tmp" 2> "$tmp.err"; then
                chown --reference="$old" "$tmp" 2>/dev/null || true
                chmod --reference="$old" "$tmp" 2>/dev/null || true
                mv -f "$tmp" "$new"
                cat "$tmp.err" >&2 || true
                rm -f "$tmp.err"
                mv -f "$old" "$old.converted"
                echo "skycue: converted $old to $new (the old file is now $old.converted)"
                return 0
            fi
            echo "skycue: could not convert $old: $(cat "$tmp.err" 2>/dev/null); convert it by hand with skycued --convert-conf" >&2
            rm -f "$tmp" "$tmp.err"
            return 1
        }
        # The overrides file skycued wrote in the state directory.
        skycue_convert_overrides() {
            o=${SKYCUE_ROOT:-}/var/lib/skycue/skycue.overrides
            if [ -f "$o.conf" ] && [ ! -e "$o.toml" ]; then
                skycue_convert_one "$o.conf" "$o.toml" || true
            fi
            return 0
        }
        # END convert-conf-shared
        # BEGIN convert-conf-deb (skycue.toml is not a conffile: it is created here, from the old skycue.conf or the shipped example)
        skycue_toml=${SKYCUE_ROOT:-}/etc/skycue/skycue.toml
        skycue_conf=${SKYCUE_ROOT:-}/etc/skycue/skycue.conf
        skycue_pristine=${SKYCUE_ROOT:-}/usr/share/skycue/skycue.toml.example
        skycue_sum=${SKYCUE_ROOT:-}/var/lib/skycue/skycue.toml.generated-sha256
        skycue_generated=0
        if [ ! -e "$skycue_toml" ]; then
            install -d "${skycue_toml%/*}"
            if [ -f "$skycue_conf" ] && skycue_convert_one "$skycue_conf" "$skycue_toml"; then
                skycue_generated=1
            elif [ -f "$skycue_pristine" ] && install -m 0644 "$skycue_pristine" "$skycue_toml"; then
                skycue_generated=1
            fi
        elif [ -f "$skycue_conf" ]; then
            # Convert over the generated file only while the operator has not edited it.
            if [ -f "$skycue_pristine" ] && cmp -s "$skycue_toml" "$skycue_pristine"; then
                if skycue_convert_one "$skycue_conf" "$skycue_toml"; then skycue_generated=1; fi
            else
                echo "skycue: $skycue_conf left as it is: $skycue_toml exists; convert it with skycued --convert-conf" >&2
            fi
        fi
        # What postrm may remove on purge: only a file still as generated here.
        if [ "$skycue_generated" = 1 ] && [ -d "${skycue_sum%/*}" ]; then
            sha256sum "$skycue_toml" | cut -d ' ' -f 1 > "$skycue_sum"
        fi
        skycue_convert_overrides
        # END convert-conf-deb
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
