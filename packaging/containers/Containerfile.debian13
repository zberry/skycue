# Package build environment for the skycue .debs on Debian 13 (trixie),
# used by packaging/build-package.sh for debian13-amd64 and debian13-arm64.
# The list mirrors Build-Depends in debian/control (dpkg-buildpackage checks
# it, so drift fails the build); curl is for a ctest that fetches the web UI.
# The package build run (packaging/build-package.sh) may use the network too;
# nothing in it is meant to download, but it is not enforced.
FROM docker.io/library/debian:trixie
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential debhelper dpkg-dev cmake libboost-system-dev \
        libboost-program-options-dev libboost-test-dev zlib1g-dev python3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY build-package-inner.sh /build-package.sh
RUN chmod 755 /build-package.sh
