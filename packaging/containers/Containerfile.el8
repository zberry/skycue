# Package build environment for the skycue rpms on EL8 (Rocky Linux 8),
# used by packaging/build-package.sh el8. The list mirrors BuildRequires in
# packaging/rpm/skycue.spec (rpmbuild checks it, so drift fails the build);
# systemd carries the %{_unitdir} macros on EL8. curl (a ctest uses it) is
# in the base image.
# The package build run (packaging/build-package.sh) may use the network too;
# nothing in it is meant to download, but it is not enforced.
FROM docker.io/rockylinux/rockylinux:8
RUN dnf -y install rpm-build gcc-c++ make cmake boost-devel zlib-devel python3 \
        diffutils tar gzip systemd \
    && dnf clean all
COPY build-package-inner.sh /build-package.sh
RUN chmod 755 /build-package.sh
