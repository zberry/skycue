# skycue configuration: the template the packages fill in and the from-source build copies.
# The packages install a copy as /etc/skycue/skycue.conf with the state paths
# set; from source, copy it to a skycue.conf and pass it with skycued --config.
# Edit it.
#
# Grammar. This file is parsed, never sourced or executed:
#   - Blank lines, and lines whose first non-blank character is '#', are
#     ignored. There are no comments after a value.
#   - Every other line is KEY=value, KEY="value" or KEY='value', starting in
#     the first column, with no spaces around '=' and nothing after the value.
#   - KEY matches ^[A-Z][A-Z0-9_]*$ and must be one of skycued's keys;
#     any other key is an error.
#   - An unquoted value may contain only letters, digits and _ . , : / + @ % = -
#     (it may be empty). A "double-quoted" value may contain anything except
#     " $ ` and \. A 'single-quoted' value may contain anything except '.
#     The quotes are removed; nothing is expanded or substituted.
#   - A key given twice takes its last value.
# A malformed line or an unknown key stops skycued with exit status 2, naming
# the line number or the key. skycued also stops with exit status 2, naming
# the key, on a value outside the range given in its comment below.

# Receiver latitude in decimal degrees, -90..90 (required).
RECEIVER_LAT=
# Receiver longitude in decimal degrees, -180..180 (required).
RECEIVER_LON=
# Receiver ground altitude in metres above mean sea level. skycued adds
# ANTENNA_HEIGHT_M and uses the sum for elevation angles (MIN_ELEVATION_DEG).
RECEIVER_ALT_M=0
# Antenna height in metres above the ground at the receiver.
ANTENNA_HEIGHT_M=0

# TCP port where dump978-fa serves raw UAT messages (skycued connects to it).
DUMP978_RAW_PORT=30978
# TCP port where readsb serves JSON position output (skycued reads it).
READSB_JSON_PORT=30047
# Host skycued reads READSB_JSON_PORT on (not empty; default 127.0.0.1, this
# machine). Set it when readsb runs on another machine.
# A --readsb-host on skycued's command line overrides it.
READSB_HOST=127.0.0.1
# Host skycued reads DUMP978_RAW_PORT on (not empty; default 127.0.0.1), as
# READSB_HOST. A --dump978-host on skycued's command line overrides it.
DUMP978_HOST=127.0.0.1
# yes (default): skycued expects dump978-fa's UAT stream.
# no: there is no 978 MHz decoder; skycued neither connects to it nor expects
# anything on it (as skycued --no-uat, which overrides it).
DUMP978_ENABLE=yes
# HTTP port for the web map; 0 turns the web map off.
WEB_PORT=8080
# Address the web map listens on: 127.0.0.1 for this machine only,
# 0.0.0.0 for every interface (not empty).
WEB_BIND=127.0.0.1
# Seconds of position history drawn behind each aircraft on the web
# map, a whole number 0..3600 (0: no trails).
TRAIL_SECONDS=120
# TCP port where cue clients connect to skycued; 0 for no listener (then
# skycued forwards only to CUE_TCP_CONNECT and CUE_UDP_TARGETS).
CUE_TCP_PORT=30500
# Space-separated host:port list of cue clients that listen for
# skycued to connect to them (skycued dials each one and keeps reconnecting);
# empty for none. Works alongside CUE_TCP_PORT: both modes can be used at once.
CUE_TCP_CONNECT=
# Space-separated host:port list skycued sends UDP cues to; empty for none.
CUE_UDP_TARGETS=

# Directory where skycued records the received and sent streams
# (received-*.jsonl/.csv, sent-*.jsonl/.csv; see docs/recording-format.md);
# empty disables recording. Created if missing.
RECORD_DIR=
# Formats skycued records in, space separated: jsonl csv (either or both;
# at least one while RECORD_DIR is set).
# A received-*.jsonl file replays with `skycued --replay FILE`.
RECORD_FORMATS="jsonl csv"
# yes: skycued writes the rawData frames of pingStation JSON inputs to
# RECORD_DIR/raw-<input id>-* (.csv for 1090, .txt for UAT, both replayable
# with skycue-rawplay). Needs RECORD_DIR. The raw streams of readsb and
# dump978-fa are recorded by running skycue-rawrec. no: do not.
RECORD_RAW=no
# Disk budget for the recordings under RECORD_DIR and RECORD_DIR/raw
# together, in gigabytes (10^9 bytes; a number >= 0; 0 for no limit). When a
# new file is started the oldest recordings are deleted to stay within it;
# only files with skycue's own names are counted or deleted.
RECORD_MAX_GB=0

# Ignore aircraft farther than this from the receiver, in nautical miles (> 0).
MAX_RANGE_NM=150
# Ignore aircraft below this elevation angle from the antenna, in degrees
# (-90..90). An airborne aircraft that reports no altitude is not
# elevation-filtered.
MIN_ELEVATION_DEG=0
# Curated lists, read by skycued at startup. One entry per line: an address
# (six hex digits) or a registration (e.g. N123AB, G-ABCD; a US N-number also
# matches by its ICAO address); '#' starts a comment. A bad entry stops
# skycued with exit status 2, naming the file and line. The block list is
# checked first; an allow-listed aircraft is sent whatever its range or
# elevation. Aircraft without a position are never sent. A relative list path
# is taken from STATE_DIR when it is set, else from skycued's working directory.
# File of aircraft to always include; empty for none.
ALLOW_LIST_FILE=
# File of aircraft to always exclude; empty for none.
BLOCK_LIST_FILE=

# Minimum seconds between cues for one aircraft (an identity change is sent
# at once regardless); at least 0.1.
MIN_INTERVAL_S=1
# Maximum seconds between cues for one aircraft, even if unchanged; at least
# MIN_INTERVAL_S.
MAX_INTERVAL_S=10
# Seconds without a message before a track is dropped; at least 1.
TRACK_TIMEOUT_S=60
# Seconds between full-state keyframes on the cue stream; at least 1.
KEYFRAME_INTERVAL_S=10

# FIS-B weather from the 978 MHz ground uplinks (dump978's raw port, or the
# "uat_uplink" records of a replayed recording). yes: decode NEXRAD, the other
# weather rasters, METAR/TAF/PIREP/winds text and NOTAM/AIRMET/SIGMET/SUA
# (TWGO) reports, keep the current ones until they expire, and record them in
# RECORD_DIR as fisb-*.jsonl when RECORD_FORMATS includes jsonl. no: uplinks
# are still recorded in the received stream but not decoded.
FISB_ENABLE=yes
# yes: also decode the layouts the open decoders disagree on (APDU time options
# 1 and 3, radar blocks at or above 60 N). Leave at no unless testing.
FISB_EXPERIMENTAL=no

# STATE_DIR: an absolute directory for the files skycued keeps (the inputs,
# statistics and learned report locations); a relative INPUTS_FILE,
# LOCATIONS_FILE, STATS_FILE, ALLOW_LIST_FILE or BLOCK_LIST_FILE is taken from
# it. Empty (default): those files live next to this file
# (the list files: skycued's working directory).
STATE_DIR=
# MAP_DIR: an absolute directory the web map's tiles/ and overlays/ are served
# from, and nowhere else. Empty (default): the ones in
# skycued's web directory.
MAP_DIR=

# INPUTS_FILE: where the receiver inputs added in the web UI are kept; default
# skycue.inputs.json next to this file. A relative path is taken from this
# file's directory, or from STATE_DIR when it is set.
INPUTS_FILE=

# LOCATIONS_FILE: optional CSV id,lat,lon merged under the learned report
# positions (fisb-locations.json next to this file, learned from the FIS-B
# reports; a learned position wins); build one with scripts/maps/make-locations.py.
# A relative path is taken from this file's directory, or from STATE_DIR when
# it is set. Read at startup: a change needs a restart.
LOCATIONS_FILE=

# STATS_FILE: where the statistics view's history (time series, coverage,
# aircraft ledger) is kept; default skycue.stats.json next to this file. A
# relative path is taken from this file's directory, or from STATE_DIR when it
# is set; empty: the statistics are kept in memory only and start empty at
# every start. A file that cannot
# be read back is renamed <file>.bad. Read at startup: a change needs a restart.
STATS_FILE=skycue.stats.json
# STATS_AIRCRAFT_MAX: aircraft kept in the statistics ledger, a whole number
# 100..100000; past it the 5 % heard longest ago are forgotten. (The cap
# keeps the file, about 300 bytes an aircraft, readable at startup.)
STATS_AIRCRAFT_MAX=20000
# STATS_SAVE_S: seconds between saves of STATS_FILE while it changed, a whole
# number 10..86400; it is also saved at a clean shutdown.
STATS_SAVE_S=300
